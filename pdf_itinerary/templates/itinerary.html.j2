<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ itinerary.title }}</title>
  <link rel="stylesheet" href="{{ styles_href }}">
</head>
<body>

{# ---------- Cover ---------- #}
<section class="cover">
  {% if hero_src %}
    <div class="cover-image" style="background-image: url('{{ hero_src }}');"></div>
  {% endif %}
  <div class="cover-veil"></div>
  <div class="cover-stamp">Aurora &middot; Bespoke Travel</div>
  <div class="cover-overlay">
    <div class="cover-rule"></div>
    <h1 class="cover-title">{{ itinerary.title }}</h1>
    {% if dates %}
      <div class="cover-dates">{{ dates }}</div>
    {% endif %}
    {% if itinerary.member %}
      <p class="cover-member">Prepared for {{ itinerary.member }}</p>
    {% endif %}
  </div>
</section>

{# ---------- Intro ---------- #}
{% if itinerary.intro_html %}
<section class="intro">
  <div class="intro-eyebrow">Introduction</div>
  <h2>{{ itinerary.title }}</h2>
  <div class="intro-body">{{ itinerary.intro_html | safe }}</div>
</section>
{% endif %}

{# ---------- Sections ---------- #}
{% for section in itinerary.sections %}
{% set hero_image = section.images[0] if section.images else None %}
{% set rest_images = section.images[1:] if section.images and section.images|length > 1 else [] %}
<section class="trip-section">
  <header class="section-header">
    {% if section.date %}<div class="section-date">{{ section.date }}</div>{% endif %}
    <h2 class="section-title">{{ section.title }}</h2>
    <div class="section-rule"></div>
  </header>

  {% if hero_image %}
    {% set hero_url = resolve_one(hero_image) %}
    {% if hero_url %}
      <img class="hero-strip" src="{{ hero_url }}" />
    {% endif %}
  {% endif %}

  {% if section.body_html %}
    <div class="section-body">{{ section.body_html | safe }}</div>
  {% endif %}

  {% if rest_images %}
    {{ render_image_grid(rest_images) }}
  {% endif %}

  {% for gallery in section.galleries %}
    <div class="gallery">
      <h4 class="gallery-name">{{ gallery.name }}</h4>
      {{ render_image_grid(gallery.images) }}
    </div>
  {% endfor %}

  {% if section.attachments %}
    <div class="attachments">
      {% for att in section.attachments %}
        {% set anchor = attachment_anchor(att) %}
        <a class="attachment-card" id="{{ anchor }}" href="#{{ anchor }}">
          <span class="attachment-icon">&#x2398;</span>
          <span class="attachment-text">
            <span class="attachment-label">Attached document</span>
            <span class="attachment-name">{{ att }}</span>
          </span>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% endfor %}

</body>
</html>
